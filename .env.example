# ARMOYU Core SDK Environment Variables
# Copy this file to .env and set your values for local testing.
# When used as a package, it will inherit from the host project's .env

ARMOYU_SOCKET_URL=http://localhost:3000

# V1/Old direct bot API key
ARMOYU_API_KEY=YOUR_V1_DIRECT_API_KEY
ARMOYU_TEST_USERNAME=your_test_user
ARMOYU_TEST_PASSWORD=your_test_password

# V2/Current API configuration for local testing
ARMOYU_V2_API_KEY=YOUR_V2_DIRECT_API_KEY
ARMOYU_TEST_BASE_URL=http://localhost:8000

