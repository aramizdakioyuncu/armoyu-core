{
  "name": "@armoyu/core",
  "version": "1.2.1",
  "description": "Core business logic, models, and services for ARMOYU platforms.",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "cd examples/console && npm run dev",
    "build:bundle": "esbuild src/index.ts --bundle --outfile=dist/armoyu-core.bundle.js --platform=browser --global-name=ArmoyuCore --minify",
    "build:watch": "tsc --watch",
    "test": "npx tsx tests/auth-guards.test.ts && npx tsx --env-file=.env tests/user-enrichment.test.ts && npx tsx --env-file=.env tests/news-enrichment.test.ts && npx tsx --env-file=.env tests/search-enrichment.test.ts && npx tsx --env-file=.env tests/event-enrichment.test.ts",
    "test:auth": "npm run test:auth:login && npm run test:auth:me && npm run test:auth:password",
    "test:auth:login": "npx tsx --env-file=.env tests/auth/login.test.ts",
    "test:auth:me": "npx tsx --env-file=.env tests/auth/me.test.ts",
    "test:auth:password": "npx tsx --env-file=.env tests/auth/password.test.ts",
    "test:user": "npx tsx --env-file=.env tests/services/user.test.ts",
    "test:community": "npx tsx --env-file=.env tests/services/community.test.ts",
    "test:social": "npx tsx --env-file=.env tests/services/social.test.ts",
    "test:blog": "npm run test:blog:list && npm run test:blog:crud",
    "test:blog:list": "npx tsx --env-file=.env tests/blog/list.test.ts",
    "test:blog:crud": "npx tsx --env-file=.env tests/blog/crud.test.ts",
    "test:chat": "npm run test:chat:history && npm run test:chat:inbox && npm run test:chat:send && npm run test:chat:actions",
    "test:chat:history": "npx tsx --env-file=.env tests/chat/history.test.ts",
    "test:chat:inbox": "npx tsx --env-file=.env tests/chat/inbox.test.ts",
    "test:chat:send": "npx tsx --env-file=.env tests/chat/send.test.ts",
    "test:chat:actions": "npx tsx --env-file=.env tests/chat/actions.test.ts",
    "test:block": "npm run test:block:list && npm run test:block:actions",
    "test:block:list": "npx tsx --env-file=.env tests/block/list.test.ts",
    "test:block:actions": "npx tsx --env-file=.env tests/block/actions.test.ts",
    "test:forum": "npm run test:forum:list && npm run test:forum:detail && npm run test:forum:crud",
    "test:forum:list": "npx tsx --env-file=.env tests/forum/list.test.ts",
    "test:forum:detail": "npx tsx --env-file=.env tests/forum/detail.test.ts",
    "test:forum:crud": "npx tsx --env-file=.env tests/forum/crud.test.ts",
    "test:group": "npm run test:group:list && npm run test:group:crud && npm run test:group:members",
    "test:group:list": "npx tsx --env-file=.env tests/group/list.test.ts",
    "test:group:crud": "npx tsx --env-file=.env tests/group/crud.test.ts",
    "test:group:members": "npx tsx --env-file=.env tests/group/members.test.ts",
    "test:education": "npm run test:education:schools && npm run test:education:classrooms && npm run test:education:crud",
    "test:education:schools": "npx tsx --env-file=.env tests/education/schools.test.ts",
    "test:education:classrooms": "npx tsx --env-file=.env tests/education/classrooms.test.ts",
    "test:education:crud": "npx tsx --env-file=.env tests/education/crud.test.ts",
    "test:event": "npm run test:event:list && npm run test:event:detail && npm run test:event:participants",
    "test:event:list": "npx tsx --env-file=.env tests/event/list.test.ts",
    "test:event:detail": "npx tsx --env-file=.env tests/event/detail.test.ts",
    "test:event:participants": "npx tsx --env-file=.env tests/event/participants.test.ts",
    "test:poll": "npx tsx --env-file=.env tests/poll/surveys.test.ts",
    "test:support": "npx tsx --env-file=.env tests/services/support.test.ts",
    "test:staff": "npx tsx --env-file=.env tests/services/staff.test.ts",
    "test:rule": "npx tsx --env-file=.env tests/services/rule.test.ts",
    "test:payment": "npx tsx --env-file=.env tests/payment/invoices.test.ts",
    "test:project": "npx tsx --env-file=.env tests/project/projects.test.ts",
    "test:reels": "npx tsx --env-file=.env tests/reels/reels.test.ts",
    "test:social:posts": "npx tsx --env-file=.env tests/social/posts.test.ts",
    "test:music": "npx tsx --env-file=.env tests/music/songs.test.ts",
    "test:media": "npx tsx --env-file=.env tests/media/gallery.test.ts",
    "test:user:profile": "npx tsx --env-file=.env tests/user/profile.test.ts",
    "test:team:list": "npx tsx --env-file=.env tests/team/teams.test.ts",
    "test:shop": "npx tsx --env-file=.env tests/shop/shop.test.ts",
    "test:search": "npx tsx --env-file=.env tests/search/search.test.ts",
    "test:management": "npm run test:management:users && npm run test:management:meetings",
    "test:management:users": "npx tsx --env-file=.env tests/management/users.test.ts",
    "test:management:meetings": "npx tsx --env-file=.env tests/management/meetings.test.ts",
    "test:location": "npm run test:location:countries && npm run test:location:provinces && npm run test:location:counties",
    "test:location:countries": "npx tsx --env-file=.env tests/location/countries.test.ts",
    "test:location:provinces": "npx tsx --env-file=.env tests/location/provinces.test.ts",
    "test:location:counties": "npx tsx --env-file=.env tests/location/counties.test.ts",
    "test:story": "npx tsx --env-file=.env tests/story/story.test.ts",
    "test:team": "npx tsx --env-file=.env tests/services/team.test.ts",
    "test:api": "npm run test:auth && npm run test:user && npm run test:community && npm run test:social && npm run test:blog && npm run test:chat && npm run test:block && npm run test:poll && npm run test:support && npm run test:staff && npm run test:rule && npm run test:location && npm run test:story && npm run test:team",
    "test:debug": "npx tsx --env-file=.env tests/debug-filtering.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "build": "^0.1.4",
    "run": "^1.5.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.6.0",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.0.0"
  }
}
